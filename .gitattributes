# Bundled runtime assets retain the exact bytes recorded in their manifest.
client/chat.html -text -whitespace
client/chat/styles/* -text -whitespace
client/vendor/** -text -whitespace

# Keep installers POSIX/PowerShell-safe across Windows checkouts.
install-linux.sh text eol=lf
install-macos.sh text eol=lf
install.ps1 text eol=lf
